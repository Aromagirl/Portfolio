---
import { withBase } from '../../utils/paths';
interface Props { class?: string }
const { class: className } = Astro.props;
---
<span class:list={['brand-mark', className]} aria-hidden="true">
  <img class="logo-light" src={withBase('/images/brand/logo-light.svg')} alt="" width="301" height="300" decoding="async" />
  <img class="logo-dark" src={withBase('/images/brand/logo-dark.svg')} alt="" width="302" height="300" decoding="async" />
</span>
<style>
  .brand-mark{display:inline-block;position:relative;width:2.25rem;height:2.25rem;flex-shrink:0}
  img{display:block;width:100%;height:100%;object-fit:contain}
  .logo-dark{display:none}
  :global(.dark) .logo-light{display:none}
  :global(.dark) .logo-dark{display:block}
  @media(max-width:479px){.brand-mark{width:2rem;height:2rem}}
</style>
