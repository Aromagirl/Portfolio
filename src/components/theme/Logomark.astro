---
interface Props { class?: string }
const { class: className = 'size-7' } = Astro.props;
---
<svg class={className} viewBox="0 0 32 32" fill="none" aria-hidden="true">
  <rect width="32" height="32" rx="9" fill="var(--inverse)" />
  <path d="M10 22V10l12 12V10" stroke="var(--accent)" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" />
</svg>
