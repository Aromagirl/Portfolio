---
import { workTagGroups } from '../../data/work-tags';
import type { CollectionEntry } from 'astro:content';
interface Props { projects: CollectionEntry<'projects'>[] }
const { projects } = Astro.props;
const groups = workTagGroups.map(group => ({
  ...group,
  tags: group.tags.map(tag => ({ ...tag, count: projects.filter(project => project.data[group.id].includes(tag.id)).length })).filter(tag => tag.count > 0),
}));
---
<aside class="work-filters" aria-label="Filter projects" data-work-filters hidden>
  <details open>
    <summary>Filters <span data-active-count></span></summary>
    <div class="filter-panel">
      {groups.map(group => group.tags.length > 0 && <fieldset>
        <legend>{group.label}</legend>
        <div class="filter-options">
          {group.tags.map(tag => <label>
            <input type="checkbox" name={group.id} value={tag.id} aria-controls="work-results" />
            <span>{tag.label}</span><span class="tag-count">{tag.count}</span>
          </label>)}
        </div>
      </fieldset>)}
      <button type="button" class="clear-filters" data-clear-filters disabled>Clear filters</button>
    </div>
  </details>
</aside>
<style>
  .work-filters{min-width:0}
  summary{font-weight:500;cursor:pointer;min-height:44px;padding:.65rem 0}
  .filter-panel{padding:1.25rem 0;display:grid;gap:2rem}
  fieldset{min-width:0;border:0;padding:0;margin:0}
  legend{font-size:.8rem;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);margin-bottom:1rem}
  .filter-options{display:grid;gap:.25rem}
  label{display:flex;align-items:center;gap:.65rem;min-height:44px;cursor:pointer;font-size:.95rem;border-radius:.5rem;padding:.4rem .5rem}
  label:hover{background:var(--sunken)}
  label:has(input:checked){background:var(--sunken);font-weight:600}
  input{width:1rem;height:1rem;accent-color:var(--ink);flex-shrink:0}
  .tag-count{margin-left:auto;color:var(--muted);font-size:.85rem;font-variant-numeric:tabular-nums}
  .clear-filters{justify-self:start;min-height:44px;text-decoration:underline;text-underline-offset:.2em;cursor:pointer;font-size:.9rem}
  .clear-filters:disabled{color:var(--muted);cursor:default;text-decoration:none}
  @media(min-width:1024px){summary{display:none}.filter-panel{padding-top:0}}
  @media(max-width:1023px){.work-filters{border-block:1px solid var(--line)}.filter-panel{grid-template-columns:repeat(2,minmax(0,1fr));gap:1.5rem}.clear-filters{grid-column:1/-1}}
  @media(max-width:479px){.filter-panel{grid-template-columns:minmax(0,1fr)}}
</style>
