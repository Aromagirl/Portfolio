---
import Icon from './Icon.astro';
import { withBase } from '../../utils/paths';
import Logomark from './Logomark.astro';
import { closing } from '../../config/home';
import { navigation, siteConfig } from '../../config/site';

interface Props {
  closing?: boolean;
}

const { closing: showClosing = true } = Astro.props;
const { email } = siteConfig.author;
const year = new Date().getFullYear();
---

{showClosing && (
  <section id="contact" class="shell mt-24 sm:mt-32" aria-labelledby="closing-title">
    <div class="relative overflow-hidden rounded-[2rem] bg-night px-6 py-14 text-night-ink sm:px-12 sm:py-20 lg:px-20 lg:py-24">
      <div class="closing-grid" aria-hidden="true" />
      <div class="relative">
        <p class="eyebrow text-night-muted">{closing.eyebrow}</p>
        <h2 id="closing-title" class="mt-6 max-w-[18ch] text-headline">
          {closing.title} <span class="serif text-accent">{closing.highlight}</span>
        </h2>
        <p class="mt-6 max-w-xl text-lead text-night-muted">{closing.text}</p>
        <div class="mt-10 flex flex-wrap items-center gap-3">
          <a class="btn btn-accent" href={`mailto:${email}`}>
            {email}
            <Icon name="arrow-up-right" class="icon-nudge-diagonal size-4" />
          </a>
          <a class="btn text-night-ink underline-offset-4 hover:underline" href={withBase('/about/')}>
            About me
          </a>
        </div>
      </div>
    </div>
  </section>
)}

<footer class="site-footer mt-24 border-t border-line sm:mt-32">
  <div class="shell footer-main">
    <div class="footer-identity">
      <a href={withBase('/')} class="footer-brand">
        <Logomark />
        <span>{siteConfig.name}</span>
        <span class="sr-only">, home</span>
      </a>
      <p class="footer-role">
        {siteConfig.author.role}
      </p>
    </div>

    <div class="footer-links">
      <nav aria-label="Footer">
        <ul class="footer-navigation">
          <li>
            <a class="footer-link" href={withBase('/')}>
              Home
            </a>
          </li>
          {navigation.map((link) => (
            <li>
              <a class="footer-link" href={withBase(link.href)}>
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <ul class="footer-contact" aria-label="Contact links">
        <li><a class="footer-link" href={`mailto:${email}`}>{email}<Icon name="arrow-up-right" class="size-3.5" /></a></li>
        {siteConfig.socials.map((social) => (
          <li>
            <a class="footer-link" href={social.href} rel="me noopener">
              {social.label}
              <Icon name="arrow-up-right" class="size-3.5" />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <div class="shell footer-bottom">
    <p>
      &copy; {year} {siteConfig.author.name}
    </p>
    <a href="#main" class="footer-top">
      Back to top
      <Icon name="arrow-up" class="size-3.5" />
    </a>
  </div>
</footer>

<style>
  #contact {
    scroll-margin-top: calc(var(--header-h) + 1rem);
  }

  .footer-main{display:flex;align-items:start;justify-content:space-between;gap:2rem;padding-block:2.5rem}
  .footer-brand{display:inline-flex;align-items:center;gap:.75rem;font-size:1.15rem;font-weight:600;letter-spacing:-.03em;color:var(--ink)}
  .footer-role{margin-top:.75rem;font-size:.95rem;color:var(--muted)}
  .footer-links{display:grid;justify-items:end;gap:1rem}
  .footer-navigation,.footer-contact{display:flex;flex-wrap:wrap;align-items:center;justify-content:flex-end;gap:.5rem 2rem}
  .footer-navigation{font-weight:500}
  .footer-contact{font-size:.9rem}
  .footer-contact .footer-link{color:var(--muted)}
  .footer-bottom{display:flex;align-items:center;justify-content:space-between;gap:1rem;border-top:1px solid var(--line);padding-block:1.25rem;font-size:.8rem;color:var(--muted)}
  .footer-top{display:inline-flex;align-items:center;gap:.5rem;min-height:44px}
  .site-footer a:focus-visible{outline:2px solid var(--ink);outline-offset:5px;border-radius:3px}
  @media(max-width:639px){
    .footer-main{flex-direction:column;gap:1.5rem;padding-block:2rem}
    .footer-links{justify-items:start;gap:.75rem;width:100%}
    .footer-navigation,.footer-contact{justify-content:flex-start;gap:.25rem 1.5rem}
    .footer-contact{align-items:start;flex-direction:column}
    .footer-bottom{flex-wrap:wrap;padding-block:1rem}
  }

  .footer-link {
    display:inline-flex;
    align-items:center;
    gap:.5rem;
    min-height:44px;
    color: var(--ink);
    transition: color 160ms ease;
  }

  .footer-link:hover {
    color: var(--ink);
    text-decoration:underline;
    text-underline-offset:4px;
  }

  .closing-grid {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle at 1px 1px, rgb(255 255 255 / 0.09) 1px, transparent 0);
    background-size: 24px 24px;
    mask-image: radial-gradient(ellipse 70% 90% at 100% 100%, #000 10%, transparent 70%);
  }
</style>
