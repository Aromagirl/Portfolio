---
import manifest from '../../migration/manifest.json';
const { src, alt = '' } = Astro.props;
const asset = manifest.pages.flatMap(p => p.assets).find(a => 'localPath' in a && a.localPath === src);
const animated = asset && 'animated' in asset && asset.animated;
const poster = animated && 'poster' in asset ? asset.poster : src;
---
<span class="case-media">
  {animated && <button class="animation-toggle" type="button" data-animation={src} data-poster={poster} aria-pressed="false">Play prototype animation</button>}
  <a class="image-link" href={src} aria-label={`Open image: ${alt}`}><img src={poster} alt={alt} width={asset && 'outputWidth' in asset ? asset.outputWidth : undefined} height={asset && 'outputHeight' in asset ? asset.outputHeight : undefined} loading="lazy" decoding="async" /></a>
</span>
<script>
  document.querySelectorAll<HTMLButtonElement>('.animation-toggle').forEach(button => {
    button.addEventListener('click', () => {
      const image = button.parentElement?.querySelector('img');
      if (!image) return;
      const play = button.getAttribute('aria-pressed') !== 'true';
      image.src = (play ? button.dataset.animation : button.dataset.poster)!;
      button.setAttribute('aria-pressed', String(play));
      button.textContent = play ? 'Pause prototype animation' : 'Play prototype animation';
    });
  });
</script>
<style>
  .animation-toggle{font:inherit;font-size:.85rem;padding:10px 16px;border:1px solid #486647;border-radius:6px;color:#222c27;background:#edf0e7;cursor:pointer;margin-block:8px}
  .animation-toggle:focus-visible{outline:3px solid #486647;outline-offset:4px}
</style>
