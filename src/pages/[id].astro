---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import CaseImage from '../components/CaseImage.astro';
import ContentLink from '../components/ContentLink.astro';
import { withBase } from '../utils/paths';
import CompanyOverview from '../components/theme/CompanyOverview.astro';
import MarkdownBody from '../components/MarkdownBody.astro';
import EditablePage from '../components/EditablePage.astro';
import { getWorkSections } from '../utils/work';

export async function getStaticPaths() {
  const pages = await getCollection('pages', ({ id, data }) => id !== 'home' && data.status === 'published');
  const projects = await getCollection('projects', ({ data }) => Boolean(data.casePage));
  return [
    ...pages.map(page => ({ params: { id: page.id === 'about-me' ? 'about' : page.id }, props: { page } })),
    ...projects.filter(project => !pages.some(page => page.id === project.data.casePage)).map(project => ({
      params: { id: project.data.casePage! }, props: { page: project, legacyProject: project },
    })),
  ];
}
const { page, legacyProject } = Astro.props;
const { Content } = await render(page);
const isAbout = page.id === 'about-me';
const project = legacyProject ?? (await getCollection('projects')).find(project => project.data.casePage === page.id);
const sections = project ? await getWorkSections(project) : [];
const splitRole = Boolean(project?.filePath?.endsWith('.md') && /^#{2,3} My role\b/im.test(project?.body ?? ''));
---
<BaseLayout title={project?.data.title ?? page.data.title} description={project?.data.summary ?? page.data.summary}>
  <div class:list={['shell', { 'case-shell': sections.length > 0 }]}>
  {project && sections.length > 0 ? <>
    <nav class="case-breadcrumb" aria-label="Breadcrumb"><a href={withBase('/work/')}>Work</a><span aria-hidden="true">/</span><span aria-current="page">{project.data.title}</span></nav>
    <CompanyOverview project={project} sections={sections} splitRole={splitRole}>
      {page.filePath?.endsWith('.md') ? <MarkdownBody entryId={project.id} splitRole={splitRole}><Content /></MarkdownBody> : <Content components={{ img: CaseImage, a: ContentLink }} />}
    </CompanyOverview>
  </> : <>
  <div class:list={isAbout ? ['about-page'] : ['prose', 'source-content', 'section-content', `section-${page.id}`]} data-source-content>
    <>{isAbout ? <EditablePage page="about-me"><Content /></EditablePage> : <Content components={{ img: CaseImage, a: ContentLink }} />}</>
  </div>
  </>}
  </div>
</BaseLayout>
