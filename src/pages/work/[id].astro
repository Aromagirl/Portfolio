---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CaseImage from '../../components/CaseImage.astro';
import ContentLink from '../../components/ContentLink.astro';
import { withBase } from '../../utils/paths';
import CaseHeading from '../../components/theme/CaseHeading.astro';
import CompanyOverview from '../../components/theme/CompanyOverview.astro';
import MarkdownBody from '../../components/MarkdownBody.astro';
import CaseIndex from '../../components/CaseIndex.astro';
import { getWorkSections } from '../../utils/work';
export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => !data.casePage);
  return projects.map(project => ({ params: { id: project.data.slug }, props: { project } }));
}
const { project } = Astro.props;
const { Content, headings } = await render(project);
const sections = await getWorkSections(project);
const splitRole = Boolean(project.filePath?.endsWith('.md') && /^#{2,3} My role\b/im.test(project.body ?? ''));
const contents = headings.filter(h => h.depth === 2 && h.text !== project.data.title && /\p{L}/u.test(h.text));
---
<BaseLayout title={project.data.title} description={project.data.summary}>
  <div class="shell case-shell">
    <nav class="case-breadcrumb" aria-label="Breadcrumb"><a href={withBase('/work/')}>Work</a><span aria-hidden="true">/</span><span aria-current="page">{project.data.title}</span></nav>
    {sections.length > 0 || splitRole ? <CompanyOverview project={project} sections={sections} splitRole={splitRole}>
      {project.filePath?.endsWith('.md') ? <MarkdownBody entryId={project.id} splitRole={splitRole} part={sections.length === 0 ? 'overview' : undefined}><Content /></MarkdownBody> : <Content components={{ img: CaseImage, a: ContentLink }} />}
    </CompanyOverview> : <>
    <CaseIndex headings={contents} />
    <article class="prose source-content case-content" data-source-content><Content components={{ img: CaseImage, a: ContentLink, h2: CaseHeading }} /></article>
    </>}
    {splitRole && sections.length === 0 && contents.some(h => !/^My role\b/i.test(h.text)) && <>
      <CaseIndex headings={contents} />
      <article class:list={['prose', 'source-content', 'case-content', { 'research-case': ['myhospital', 'kidswearcycle', 'myhospital-app', 'kidswearcycle-website'].includes(project.data.slug) }]} data-source-content><MarkdownBody entryId={project.id} part="case"><Content /></MarkdownBody></article>
    </>}
  </div>
</BaseLayout>
