---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CaseImage from '../../components/CaseImage.astro';
export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => data.status === 'published');
  return projects.map(project => ({ params: { id: project.id }, props: { project } }));
}
const { project } = Astro.props;
const { Content, headings } = await render(project);
const contents = headings.filter(h => h.depth === 2 && h.text !== project.data.title && /\p{L}/u.test(h.text));
---
<BaseLayout title={project.data.title} description={project.data.summary}>
  <a class="back-link" href="/">← All work</a>
  <div class="case-shell">
    <aside class="case-index" aria-label="Case study navigation">
      <p class="eyebrow">{project.data.category}</p>
      <h1>{project.data.title}</h1>
      <p>{project.data.summary}</p>
      {contents.length > 0 && <nav aria-label="On this page"><p class="eyebrow">On this page</p>{contents.map(h => <a href={`#${h.slug}`}>{h.text}</a>)}</nav>}
      <a class="source-link" href={project.data.sourceUrl}>Original case study ↗</a>
    </aside>
    <article class="prose case-content" data-source-content><Content components={{ img: CaseImage }} /></article>
  </div>
</BaseLayout>
