---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CaseImage from '../../components/CaseImage.astro';
import ContentLink from '../../components/ContentLink.astro';
import { withBase } from '../../utils/paths';
import CaseHeading from '../../components/theme/CaseHeading.astro';
export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => data.status === 'published');
  return projects.map(project => ({ params: { id: project.id }, props: { project } }));
}
const { project } = Astro.props;
const { Content, headings } = await render(project);
const contents = headings.filter(h => h.depth === 2 && h.text !== project.data.title && /\p{L}/u.test(h.text));
---
<BaseLayout title={project.data.title} description={project.data.summary}>
  <div class="shell case-shell">
    <nav class="case-breadcrumb" aria-label="Breadcrumb"><a href={withBase('/work/')}>Work</a><span aria-hidden="true">/</span><span aria-current="page">{project.data.title}</span></nav>
    {contents.length > 0 && <details class="case-index"><summary>On this page</summary><nav aria-label="On this page">{contents.map(h => <a href={`#${h.slug}`}>{h.text}</a>)}</nav></details>}
    <article class="prose source-content case-content" data-source-content><Content components={{ img: CaseImage, a: ContentLink, h2: CaseHeading }} /></article>
    {project.data.sourceUrl && <a class="source-link" href={project.data.sourceUrl}>Original case study ↗</a>}
  </div>
</BaseLayout>
