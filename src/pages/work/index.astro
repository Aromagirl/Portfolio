---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/theme/ProjectCard.astro';
import { withBase } from '../../utils/paths';
import { projectPresentation, workNavigation } from '../../config/site';
const projects = (await getCollection('projects', ({ data }) => data.status === 'published')).sort((a,b) => a.data.sortOrder-b.data.sortOrder);
const marketing = (await getCollection('pages', ({ data }) => data.status === 'published')).find(p => p.id === 'marketing-design');
const safeClick = projects.find(p => p.id === 'safeclick');
const remainingProjects = projects.filter(p => p.id !== 'safeclick');
---
<BaseLayout title="Work" description="Selected UX/UI, interactive and marketing design projects by Natalia Isakova.">
  <div class="shell pt-14 sm:pt-20">
    <p class="eyebrow">Portfolio</p>
    <h1 class="mt-6 max-w-[18ch] text-headline">Selected <span class="serif">work.</span></h1>
    <nav class="category-nav" aria-label="Work categories">{workNavigation.map(link => <a class="chip" href={withBase(link.href)} aria-current={link.href === '/work/' ? 'page' : undefined}>{link.label}</a>)}</nav>
    <div class="mt-12 grid gap-x-8 gap-y-16 md:grid-cols-2">
      {safeClick && <ProjectCard title={safeClick.data.title} summary={safeClick.data.summary} href={`/work/${safeClick.id}/`} cover={safeClick.data.cover} tint={projectPresentation.safeclick.tint} eager fillCover />}
      {marketing && <ProjectCard title="FraudScore" summary={marketing.data.summary} href="/marketing-design/" cover={projectPresentation['marketing-design'].cover||marketing.data.cover} tint={projectPresentation['marketing-design'].tint} eager fillCover />}
      {remainingProjects.map((p,i) => <ProjectCard title={p.data.title} summary={p.data.summary} href={`/work/${p.id}/`} cover={projectPresentation[p.id]?.cover||p.data.cover} tint={projectPresentation[p.id]?.tint} eager={i < 2 - Number(Boolean(safeClick)) - Number(Boolean(marketing))} fillCover={p.id === 'mafia-bot-mini-app'} />)}
    </div>
  </div>
</BaseLayout>
