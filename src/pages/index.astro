---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import CaseImage from '../components/CaseImage.astro';
const entry = await getEntry('home', 'home');
if (!entry) throw new Error('Homepage content is missing');
const { Content } = await render(entry);
---
<BaseLayout title="Natalia Isakova" home>
  <div class="prose home-content" data-source-content><Content components={{ img: CaseImage }} /></div>
</BaseLayout>
