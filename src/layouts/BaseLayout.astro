---
import '../styles/global.css';
interface Props { title: string; description?: string; home?: boolean }
const { title, description = 'UX/UI & Interactive designer — Natalia Isakova', home = false } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f8f7f4" />
    <title>{title === 'Natalia Isakova' ? title : `${title} — Natalia Isakova`}</title>
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="wordmark" href="/" aria-label="Natalia Isakova, home">Natalia Isakova<span aria-hidden="true">.</span></a>
      <nav aria-label="Main navigation">
        <a href="/" aria-current={home ? 'page' : undefined}>Work</a>
        <a href="mailto:nisakova.info@gmail.com">Contact <span aria-hidden="true">↗</span></a>
      </nav>
    </header>
    <main id="main" class:list={['page', { 'home-page': home }]}><slot /></main>
    <footer class="site-footer">
      <div><a class="wordmark" href="/">Natalia Isakova<span aria-hidden="true">.</span></a><p>UX/UI & Interactive designer</p></div>
      <div class="footer-links"><a href="mailto:nisakova.info@gmail.com">nisakova.info@gmail.com ↗</a><a href="https://www.linkedin.com/in/ux-natalia-isakova/">LinkedIn ↗</a></div>
    </footer>
  </body>
</html>
