---
import '../styles/global.css';
import { withBase } from '../utils/paths';
import SiteHeader from '../components/theme/SiteHeader.astro';
import SiteFooter from '../components/theme/SiteFooter.astro';
interface Props { title: string; description?: string; home?: boolean }
const { title, description = 'Product Designer & Builder — Natalia Isakova', home = false } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#fafaf7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0d0d0c" media="(prefers-color-scheme: dark)" />
    <title>{title === 'Natalia Isakova' ? title : `${title} — Natalia Isakova`}</title>
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="preload" href={withBase('/fonts/hanken-grotesk/hanken-grotesk-latin.woff2')} as="font" type="font/woff2" crossorigin />
    <script is:inline>
      (() => {
        const storageKey = 'portfolio-theme';
        const root = document.documentElement;
        const systemDark = window.matchMedia('(prefers-color-scheme: dark)');
        let stored = null;
        try { const value = localStorage.getItem(storageKey); if (value === 'dark' || value === 'light') stored = value; } catch {}
        const apply = (isDark) => {
          root.classList.toggle('dark', isDark);
          document.querySelectorAll('[data-theme-toggle]').forEach(button => button.setAttribute('aria-pressed', String(isDark)));
        };
        apply(stored ? stored === 'dark' : systemDark.matches);
        systemDark.addEventListener('change', event => { if (!stored) apply(event.matches); });
        document.addEventListener('DOMContentLoaded', () => {
          apply(root.classList.contains('dark'));
          document.querySelectorAll('[data-theme-toggle]').forEach(button => button.addEventListener('click', () => {
            const isDark = !root.classList.contains('dark');
            stored = isDark ? 'dark' : 'light';
            try { localStorage.setItem(storageKey, stored); } catch {}
            apply(isDark);
          }));
        });
      })();
    </script>
    <noscript><style>[data-needs-js]{display:none!important}</style></noscript>
  </head>
  <body class="flex min-h-screen flex-col">
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader />
    <main id="main" class:list={['flex-1', { 'home-page': home }]}><slot /></main>
    <SiteFooter />
  </body>
</html>
